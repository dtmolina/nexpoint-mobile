# Base URL the mobile app uses to reach the Laravel backend.
# A physical device or emulator cannot reach "localhost" on your machine,
# so use your computer's LAN IP (find it with `ipconfig getifaddr en0` on macOS).
#
# Android emulator: use http://10.0.2.2:8000/api
# iOS simulator:    http://localhost:8000/api works
# Physical device:  http://<your-LAN-IP>:8000/api  (phone must be on the same Wi-Fi)
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api
