{
  "expo": {
    "name": "Nexpoint",
    "slug": "nexpoint-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nexpoint",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexpoint.mobile"
    },
    "android": {
      "package": "com.nexpoint.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
